[Unit]
Description=MAK durable conductor shadow worker (sentinel-gated)
After=network-online.target
ConditionPathExists=/home/mak/state/ALLOW_MAK_CONDUCTOR_SHADOW

[Service]
Type=oneshot
WorkingDirectory=/home/mak/flujo
Environment=MAK_CONDUCTOR_SHADOW=1
Environment=MAK_CONDUCTOR_ACTIVE=0
Environment=MAK_CONDUCTOR_GPU=1
ExecStart=/usr/bin/python3 /home/mak/tools/mak_ops/run_conductor_worker.py --observe-only --sentinel /home/mak/state/ALLOW_MAK_CONDUCTOR_SHADOW --import-legacy --max-jobs=0 --source-limit=1 --db /home/mak/state/mak-conductor-shadow.db --gpu-lock /home/mak/locks/mak-conductor-shadow.lock
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=mak-conductor-shadow.timer
