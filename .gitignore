# === Media de proyectos (NO ignorar imágenes del repo/docs) ===
# Solo ignorar outputs de proyectos flyer
projects/flyer_eventos/*/input/*
projects/flyer_eventos/*/working/*
projects/flyer_eventos/*/exports/*
projects/flyer_eventos/*/refs/*
!projects/flyer_eventos/*/*/.gitkeep

# Data generada
data/*.json
# ...pero estas NO son generadas: son la configuracion que edita el usuario a
# mano, y sin ellas el codigo cae a su respaldo interno. Excluirlas fue un
# defecto real: `data/rd_packs.json` se declaro "fuente unica de la tarifa" el
# 2026-07-26 y nunca entro al repo, asi que en cualquier otro checkout el rider
# cotizaba con la copia de respaldo.
!data/rd_packs.json
!data/plano_simbolos.json
!data/cotizacion_servicios.json
!data/svg_estados.json
!data/piezas_tipos.json
!data/iskvw_campo_filtro.json
!data/iskvw_librerias.json
!data/iskvw_capas.json
!data/motor_librerias.json
!data/ordering_features.json
!data/artist_discographies.json
# The expected-state baseline for tools/mak_heartbeat.py is a versioned
# declaration, not generated cache: it must travel with the repo or a fresh
# checkout has nothing to compare against.
!data/mak_expected_state.json
!data/certified_queries.json
context/DAILY.md
context/PIPELINE_RESULT.md
context/dashboard.html
# context/ visualizers y hub SÍ se versionan (son el workspace principal)

# Datadrops (selective: ignore staging images for cleanliness; keep manifests + analysis json + review package useful for AI/linea)
datadrops/incoming/
datadrops/*/*.jpg
datadrops/*/*.jpeg
datadrops/*/*.png
datadrops/*/*.gif
datadrops/*/*.bmp
datadrops/*/*.webp
!datadrops/*/*.json
!datadrops/*/analysis/*.json
!datadrops/_review_package.txt

# Temporales
*.tmp
*.temp
tmp_*/
ig_*/

# Pilot runs are local generated evidence (large JSON replays), not source
# code. Keep them on the MAK box for replay and provenance without pushing
# hundreds of megabytes into the repository.
experiments/pilots/

# xio runtime (logs + on-device secrets -- nunca al repo)
xio/**/*.log
xio/**/ntfy_topic.txt
xio/**/.pc_watch.pid

# cultura: credenciales locales (Tavily/Groq/Cerebras/Azure keys) -- nunca al repo
# glob cubre .dev y cualquier copia (.dev.limpio, .dev.bak, ...)
cultura/.dev*

# vigia: estado local de la caja (hashes vistos + validadores de conditional GET).
# Es lo que hace que un aviso se notifique UNA vez; versionarlo mezclaria el
# estado de la caja con el de cada checkout y reviviria avisos ya notificados.
cultura/mak_vigia/estado/
cultura/mak_vigia/.vigia.lock

# pieza MANIFIESTO #6 cron nocturno: variantes generadas (lapidas.log SI se versiona)
tools/cron_nocturno/salidas/

# Higiene de repo (no commitear ruído histórico)
# Keep generated caches and local state out of the repository.
# _airdrop_backups/, checkpoints/, _archive/ y reference_old/ son legacy y deben mantenerse mínimos en root.

# Carpetas de descarga de Instagram con ruta de Windows (no commitear)
C：*/
*ig_*/


