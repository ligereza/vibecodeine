{
  "schema": "vibecodeine-branch-profile-v1",
  "branch": "main",
  "canonical_ref": "main",
  "lane": "integrated",
  "kind": "integrated",
  "integration_target": "main",
  "role": "integrated MAK + FLUJO baseline; validation and release composition",
  "default_test_selector": "-m \"mak or flujo or integration or repo_hygiene\"",
  "capabilities": "CAPACIDADES_MAIN.md",
  "requirements": "requirements-integration.txt",
  "hubs": [
    {
      "module": "cultura/mak_plataforma/hub.py",
      "default_port": 8900,
      "owner": "MAK",
      "surface": "MAK departments and read-only machine projections"
    },
    {
      "module": "src/flujo/web/hub.py",
      "default_port": 8765,
      "owner": "FLUJO",
      "surface": "portable workflow and workspace"
    }
  ],
  "lane_profiles": {
    "MAK": {
      "capabilities": "CAPACIDADES_MAK.md",
      "requirements": "requirements-mak.txt",
      "selector": "-m mak"
    },
    "FLUJO": {
      "capabilities": "CAPACIDADES_FLUJO.md",
      "requirements": "requirements-flujo.txt",
      "selector": "-m flujo"
    }
  },
  "secondary_capabilities": [
    "CAPACIDADES_MAK.md",
    "CAPACIDADES_FLUJO.md"
  ],
  "transfer_contract": "carry both source trees in one reviewed baseline; preserve the MAK and FLUJO hub boundary and exchange typed contracts rather than importing one hub into the other"
}
