{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.52.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:context": "vite build && node scripts/copy-context.mjs",
    "build:plano": "vite build --config vite.plano.config.ts && node scripts/copy-plano-share.mjs",
    "preview": "vite preview",
    "build:rd": "vite build --config vite.rd.config.ts && node scripts/copy-rd-share.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.18",
    "esbuild": "^0.28.1",
    "undici-types": "8.4.0"
  }
}
