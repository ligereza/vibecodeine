      "checks": ["python3 -m pytest -q tests/test_rd_informe.py", "python3 -m flujo rd-db --help"],
      "do_not_read": ["WIN raw archive", "RD media", "live provider credentials"]
    },
    "portfolio": {
      "branch_prefix": "portfolio",
      "keywords": ["portafolio", "portfolio", "iskvw", "web", "sitio", "dominio", "cloudflare", "dns", "deploy", "publicar", "publicacion", "frontend", "pagina", "certificado", "hosting"],
      "contract": "context/diagnostics/contracts/portfolio.md",
