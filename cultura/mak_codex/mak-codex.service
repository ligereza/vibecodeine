# Canonical MAK Linux user unit.
# Canonical source: /home/mak/cultura/mak_codex/interfaz_codex.py.
[Unit]
Description=MAK Codex internal service for the Hub
[Service]
WorkingDirectory=%h/codex
Environment=CODER_CHAIN=nim-pro,nim-flash,ollama
Environment=MAK_SERVICE_HOST=127.0.0.1
ExecStart=/usr/bin/python3 %h/cultura/mak_codex/interfaz_codex.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
[Install]
WantedBy=default.target
