# User service for the internal Research interface. The cron watchdog checks
# and starts this unit; it never launches a detached session process.
[Unit]
Description=MAK Research internal service for the Hub (canvas visual)

[Service]
Type=simple
WorkingDirectory=%h/research
ExecStart=/usr/bin/python3 %h/research/interfaz.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mak-interfaz
TimeoutStopSec=15
KillMode=control-group

Environment=PYTHONUNBUFFERED=1
Environment=MAK_SERVICE_HOST=127.0.0.1
EnvironmentFile=-%h/n8n-local/research.env

[Install]
WantedBy=default.target
