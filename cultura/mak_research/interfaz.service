# Compatibility unit only. The current MAK runtime starts Research through
# watchdog/cron; this file is not installed as mak-interfaz.service. If it is
# installed later, keep MAK_SERVICE_HOST loopback and update the mirror gate.
[Unit]
Description=MAK Research internal service for the Hub (canvas visual)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/mak/research
ExecStart=/usr/bin/python3 /home/mak/research/interfaz.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mak-interfaz

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=MAK_SERVICE_HOST=127.0.0.1
EnvironmentFile=-/home/mak/n8n-local/research.env

[Install]
WantedBy=default.target
