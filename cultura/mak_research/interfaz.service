# Canonical MAK Linux user unit.
# Runtime source: /home/mak/research/interfaz.py.
[Unit]
Description=MAK Research internal service for the Hub (canvas visual)
[Service]
Type=simple
WorkingDirectory=%h/research
ExecStart=%h/research/.venv/bin/python %h/research/interfaz.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mak-interfaz
TimeoutStopSec=15
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
Environment=MAK_SERVICE_HOST=127.0.0.1
EnvironmentFile=-%h/research/research.env
[Install]
WantedBy=default.target
