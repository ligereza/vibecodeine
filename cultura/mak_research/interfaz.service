# Canonical MAK Linux user unit.
# Runtime source: %h/flujo/cultura/mak_research/interfaz.py.
[Unit]
Description=MAK Research internal service for the Hub (canvas visual)
[Service]
Type=simple
WorkingDirectory=%h/flujo/cultura/mak_research
Environment=MAK_PLATFORM_CODE_ROOT=%h/flujo/cultura/mak_plataforma
ExecStart=%h/research/.venv/bin/python %h/flujo/cultura/mak_research/interfaz.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mak-interfaz
TimeoutStopSec=15
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
Environment=MAK_SERVICE_HOST=127.0.0.1
EnvironmentFile=-%h/n8n-local/research.env
[Install]
WantedBy=default.target
