; Source unit for the optional ntfy queue. It is started only when the
; configured topic exists; it is intentionally not enabled at boot.
[Unit]
Description=MAK Research optional ntfy queue

[Service]
Type=simple
WorkingDirectory=%h/research
EnvironmentFile=-%h/research/research.env
ExecStart=/usr/bin/python3 %h/research/cola.py
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
