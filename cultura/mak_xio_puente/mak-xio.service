# Canonical MAK Linux user unit.
# Runtime source: /home/mak/xio_puente/monitor.py.
[Unit]
Description=MAK xio bridge (GET-only monitor)
[Service]
WorkingDirectory=%h/xio_puente
ExecStart=/usr/bin/python3 %h/xio_puente/monitor.py
Restart=always
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
[Install]
WantedBy=default.target
