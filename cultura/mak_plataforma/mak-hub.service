# Canonical MAK Linux user unit.
# Canonical source: /home/mak/flujo/cultura/mak_plataforma/hub.py.
[Unit]
Description=MAK hub (plataforma :8900)
[Service]
WorkingDirectory=%h/plataforma
Environment=HUB_HOST=127.0.0.1
ExecStart=%h/plataforma/.venv/bin/python %h/flujo/cultura/mak_plataforma/hub.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
[Install]
WantedBy=default.target
