# Canonical MAK Linux user unit.
# Runtime source: /home/mak/plataforma/hub.py.
[Unit]
Description=MAK hub (plataforma :8900)
[Service]
WorkingDirectory=%h/plataforma
ExecStart=%h/plataforma/.venv/bin/python %h/plataforma/hub.py
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
[Install]
WantedBy=default.target
