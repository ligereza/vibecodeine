    "link.return": {"from": "node.research_frontier", "to": "node.evidence_return", "relation": "triangulates_receipts", "invariant_ids": ["inv.authority_separation", "inv.no_automatic_promotion"]},
    "link.recompute_fit": {"from": "node.evidence_return", "to": "node.fit", "relation": "proposes_additive_recompute", "invariant_ids": ["inv.no_automatic_promotion"]},
