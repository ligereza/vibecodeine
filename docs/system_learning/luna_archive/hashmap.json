    "link.control": {"from": "node.shadow_learning", "to": "node.autonomy_plan", "relation": "influences_priority_only", "invariant_ids": ["inv.no_implicit_dispatch", "inv.product_nonexecution", "inv.outcome_scope"]}
  },
  "invariants": {
    "inv.source_immutability": {"statement": "Observation and compilation do not mutate source archives.", "applies_to": ["node.archive_source", "node.observation_batch"]},
    "inv.snapshot_identity": {"statement": "Tenant/archive identity is stable across time; snapshot identity changes with observed state.", "applies_to": ["node.archive_memory", "node.project_ir", "node.practice_state"]},
    "inv.provenance_totality": {"statement": "Every derived assertion retains resolvable source and evidence references or becomes unknown.", "applies_to": ["node.observation_batch", "node.archive_memory", "node.practice_state"]},
    "inv.partition_conservation": {"statement": "Each physical artifact reference is assigned, ambiguous, or unassigned exactly once at the unit boundary.", "applies_to": ["node.reconstruction", "node.project_ir", "node.practice_state"]},
    "inv.duplicate_nonidentity": {"statement": "Equal content proves byte equivalence, not work, project, role, or authorship identity.", "applies_to": ["node.reconstruction"]},
    "inv.uncertainty_nonpromotion": {"statement": "Candidate and unknown states are not promoted without new scoped evidence and validation.", "applies_to": ["node.project_ir", "node.practice_state", "node.possibility"]},
    "inv.meaning_conservation": {"statement": "A transformation may preserve or narrow supported meaning; it may not add authorship, intention, role, or public status.", "applies_to": ["node.practice_state", "node.portfolio_dossier"]},
    "inv.claim_evidence_binding": {"statement": "Supported and candidate claims require explicit evidence refs; missing refs force unknown or a gap.", "applies_to": ["node.practice_state", "node.fit"]},
    "inv.authority_separation": {"statement": "Practice evidence and opportunity evidence remain separate authorities joined only through explicit requirement bindings.", "applies_to": ["node.opportunity_constraints", "node.fit", "node.evidence_return", "node.application_research"]},
    "inv.no_score_semantics": {"statement": "Scores rank or bound search; they do not define meaning, project identity, or truth.", "applies_to": ["node.reconstruction", "node.possibility"]},
    "inv.no_automatic_promotion": {"statement": "Research returns and outcomes are additive proposals or bounded signals; promotion remains none.", "applies_to": ["node.evidence_return", "node.shadow_learning"]},
    "inv.no_implicit_dispatch": {"statement": "Research and autonomy outputs are plans with dispatch false and finite attempts.", "applies_to": ["node.research_frontier", "node.autonomy_plan"]},
    "inv.product_nonexecution": {"statement": "Draftable does not mean published, submitted, or externally dispatched.", "applies_to": ["node.product_plan", "node.portfolio_dossier", "node.application_research", "node.autonomy_plan"]},
    "inv.outcome_scope": {"statement": "Verified outcomes may train attention and ranking only, never factual truth, authorship, or artistic identity.", "applies_to": ["node.verified_outcome", "node.shadow_learning", "node.autonomy_plan"]}
  },
  "failure_modes": {
    "fail.case_as_architecture": {"at": ["node.reconstruction"], "symptom": "ARICA or MYRA-specific naming becomes a generic type", "guard_invariant_ids": ["inv.partition_conservation"]},
    "fail.hash_as_identity": {"at": ["node.reconstruction"], "symptom": "Duplicate bytes merge distinct artifacts or projects", "guard_invariant_ids": ["inv.duplicate_nonidentity"]},
    "fail.folder_as_authorship": {"at": ["node.project_ir"], "symptom": "A path or filename becomes an authorial claim", "guard_invariant_ids": ["inv.meaning_conservation", "inv.no_score_semantics"]},
    "fail.export_as_publication": {"at": ["node.practice_state", "node.portfolio_dossier"], "symptom": "A technical output is declared delivered or public", "guard_invariant_ids": ["inv.meaning_conservation", "inv.product_nonexecution"]},
    "fail.missing_as_negative": {"at": ["node.practice_state", "node.shadow_learning"], "symptom": "Unknown or absent evidence becomes a negative label", "guard_invariant_ids": ["inv.uncertainty_nonpromotion", "inv.outcome_scope"]},
    "fail.document_proves_fit": {"at": ["node.fit"], "symptom": "Opportunity text is reused as applicant evidence", "guard_invariant_ids": ["inv.authority_separation", "inv.claim_evidence_binding"]},
    "fail.stale_source_passes": {"at": ["node.fit"], "symptom": "Observed-local, stale, expired, or ineligible source passes a gate", "guard_invariant_ids": ["inv.authority_separation"]},
    "fail.rejected_candidate_revived": {"at": ["node.possibility"], "symptom": "A rejected program reappears as merely abstained", "guard_invariant_ids": ["inv.uncertainty_nonpromotion"]},
    "fail.research_becomes_practice": {"at": ["node.evidence_return"], "symptom": "Environmental evidence becomes evidence of the artist", "guard_invariant_ids": ["inv.authority_separation", "inv.no_automatic_promotion"]},
    "fail.draft_executes": {"at": ["node.product_plan", "node.autonomy_plan"], "symptom": "Draftability triggers publication, submission, or dispatch", "guard_invariant_ids": ["inv.product_nonexecution", "inv.no_implicit_dispatch"]},
    "fail.open_outcome_failure": {"at": ["node.shadow_learning"], "symptom": "No receipt is learned as failure", "guard_invariant_ids": ["inv.outcome_scope"]},
    "fail.fixture_readiness": {"at": ["node.autonomy_plan"], "symptom": "Passing fixtures is declared portable readiness", "guard_invariant_ids": ["inv.no_automatic_promotion"]}
  },
