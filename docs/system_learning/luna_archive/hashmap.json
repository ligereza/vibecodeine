  "links": {
    "link.observe": {"from": "node.archive_source", "to": "node.observation_batch", "relation": "observes_without_mutation", "invariant_ids": ["inv.source_immutability", "inv.provenance_totality"]},
    "link.remember": {"from": "node.observation_batch", "to": "node.archive_memory", "relation": "ingests_append_only", "invariant_ids": ["inv.snapshot_identity", "inv.provenance_totality"]},
    "link.reconstruct": {"from": "node.archive_memory", "to": "node.reconstruction", "relation": "proposes_relations_and_units", "invariant_ids": ["inv.partition_conservation", "inv.duplicate_nonidentity", "inv.no_score_semantics"]},
    "link.project": {"from": "node.reconstruction", "to": "node.project_ir", "relation": "projects_losslessly", "invariant_ids": ["inv.partition_conservation", "inv.uncertainty_nonpromotion"]},
    "link.practice": {"from": "node.project_ir", "to": "node.practice_state", "relation": "compiles_evidence_only", "invariant_ids": ["inv.meaning_conservation", "inv.claim_evidence_binding"]},
