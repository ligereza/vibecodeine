  },
  "invariants": {
    "invariant.physical_authority": {"statement": "Physical sources decide what exists; Git and documentation do not.", "node_refs": ["node.archive"]},
    "invariant.no_candidate_truth": {"statement": "Candidates, inferred relations, provisional units, hypotheses, and extracted claims never self-promote to facts.", "node_refs": ["node.copilot", "node.project_ir", "node.refuter"]},
    "invariant.authority_separation": {"statement": "Opportunity evidence and practice evidence remain separate authorities joined only by explicit requirement-to-evidence bindings.", "node_refs": ["node.opportunity", "node.practice"]},
    "invariant.abstention_is_control": {"statement": "Abstention is a safe, informative state that can schedule bounded observation or research; it is neither success nor generic failure.", "node_refs": ["node.autonomy", "node.refuter"]},
    "invariant.rejection_monotonicity": {"statement": "An independent rejection cannot be revived by a later abstaining gate.", "node_refs": ["node.refuter", "node.possibility"]},
    "invariant.common_product_state": {"statement": "Portfolio, application, and research outputs derive from one common plan and preserve shared claim, asset, requirement, privacy, license, and uncertainty controls.", "node_refs": ["node.product_compiler", "node.dossier", "node.application"]},
    "invariant.no_external_side_effect_from_plan": {"statement": "Autonomy outputs are plan-only: database write, dispatch, publication, submission, promotion, and training remain disabled.", "node_refs": ["node.autonomy", "node.external_boundary"]},
    "invariant.no_self_training_truth": {"statement": "The system may learn routing, ranking, and attention from verified external outcomes, never factual truth, authorship, artistic identity, or negative labels from open or abstained episodes.", "node_refs": ["node.learning"]},
    "invariant.explicit_validation_completion": {"statement": "A conductor job completes only after a claimed transition, result persistence, and validated output; external stages add an explicit gate.", "node_refs": ["node.conductor", "node.external_boundary"]},
    "invariant.no_topology_fusion": {"statement": "Department, organ, runtime-coherence, and owner-consumer projections may cross-reference one another but do not become a new registry by documentation fiat.", "node_refs": ["node.curatoria", "node.research", "node.conductor"]}
  },
  "control_loops": {
    "loop.evidence_closure": {
      "sequence": ["node.opportunity", "node.research", "node.refuter", "node.opportunity", "node.possibility", "node.product_compiler", "node.autonomy"],
      "feedback_signal": "fewer_explicit_gaps_or_a_better_justified_abstention",
      "stop_conditions": ["no_hash_change", "budget_exhausted", "requirement_closed", "max_attempts_one"],
      "external_effect": false
    },
    "loop.archive_reconstruction": {
      "sequence": ["node.archive", "node.observer", "node.project_ir", "node.practice", "node.refuter"],
      "feedback_signal": "balanced_partition_and_independent_evaluator_result",
      "stop_conditions": ["source_mutation_detected", "contract_invalid", "partition_unbalanced"],
      "external_effect": false
    },
    "loop.curatorial_proposal_refutation": {
      "sequence": ["node.copilot", "node.refuter", "node.product_compiler"],
      "feedback_signal": "supported_contradicted_or_unresolved_evidence",
      "stop_conditions": ["missing_evidence", "low_confidence_abstention", "rejection"],
      "external_effect": false
    },
    "loop.shadow_learning": {
      "sequence": ["node.product_compiler", "node.learning", "node.autonomy"],
      "feedback_signal": "verified_external_receipt_for_stable_identity_group",
      "stop_conditions": ["outcome_open", "insufficient_identity_groups", "independent_holdout_missing"],
      "allowed_updates": ["attention", "ranking", "routing_candidate"],
      "forbidden_updates": ["truth", "authorship", "artistic_identity", "automatic_policy_promotion"]
    }
  },
  "failure_modes": {
    "failure.false_green_contract_shape": {"symptom": "A fixture field or consumer assumption does not match the real producer contract.", "containment": "fail_closed_and_correct_the_boundary", "link_refs": ["link.research_refuter", "link.products_autonomy"]},
    "failure.source_validity_inference": {"symptom": "A local or stale opportunity document is treated as current.", "containment": "abstain_until_current_verified_plus_confirmation", "link_refs": ["link.opportunity_possibility"]},
    "failure.evidence_namespace_collision": {"symptom": "External documentary evidence is counted as internal practice evidence or public media.", "containment": "separate_namespaces_and_require_explicit_artifact_refs", "link_refs": ["link.refuter_practice_blocked", "link.practice_product"]},
    "failure.candidate_self_promotion": {"symptom": "Copilot, OCR, relation, program, or research candidates become facts without an independent gate.", "containment": "promotion_none_and_candidate_state", "link_refs": ["link.copilot_refuter", "link.rd_triangular", "link.research_refuter"]},
    "failure.product_silo_divergence": {"symptom": "Portfolio and application compile independent claims or assets.", "containment": "derive_both_from_one_common_product_plan", "link_refs": ["link.product_dossier", "link.product_application"]},
    "failure.plan_becomes_dispatch": {"symptom": "A ranked autonomy action is executed as though it carried authority.", "containment": "dispatch_false_and_no_live_wiring", "link_refs": ["link.autonomy_conductor_blocked"]},
    "failure.draft_becomes_external_fact": {"symptom": "Draftable is interpreted as published, submitted, delivered, or accepted.", "containment": "explicit_external_consequence_gate_and_receipt", "link_refs": ["link.product_dossier", "link.product_application", "link.conductor_external"]},
    "failure.self_confirming_learning": {"symptom": "The system trains on its own draft, abstention, or open outcome as truth or failure.", "containment": "verified_external_outcomes_stable_identity_groups_and_training_false", "link_refs": ["link.products_learning", "link.learning_autonomy"]},
    "failure.topology_overwrite": {"symptom": "One projection is declared canonical over departments, organs, runtime mirrors, and owners without migration evidence.", "containment": "preserve_projection_kind_and_record_crosswalk_gap", "link_refs": []}
  },
