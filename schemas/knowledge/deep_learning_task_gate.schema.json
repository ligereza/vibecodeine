{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mak.local/schemas/knowledge/deep_learning_task_gate.schema.json",
  "title": "MAK deep-learning task evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "project_id", "objective", "input_ref", "label_ref", "split", "validator"],
  "properties": {
    "schema": {"const": "mak-deep-learning-task-gate-v1"},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "input_ref": {"type": "string", "minLength": 1},
    "label_ref": {"type": "string", "minLength": 1},
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_ref", "holdout_ref", "independent", "group_key", "holdout_count"],
      "properties": {
        "train_ref": {"type": "string", "minLength": 1},
        "holdout_ref": {"type": "string", "minLength": 1},
        "independent": {"const": true},
        "group_key": {"type": "string", "minLength": 1},
        "holdout_count": {"type": "integer", "minimum": 2}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["ready", "verified", "missing"]}
      }
    }
  }
}
