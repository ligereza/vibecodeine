{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mak.local/schemas/knowledge/math_target_capsule.schema.json",
  "title": "MAK mathematical target capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_id",
    "title",
    "problem_family",
    "problem_status",
    "layer",
    "official_statement_ref",
    "semantic_fidelity_status",
    "conceptual_frame",
    "known_barriers",
    "dead_routes",
    "search_policies",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "mak-math-target-capsule-v1"},
    "target_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "problem_family": {"enum": ["millennium", "research", "subproblem", "benchmark"]},
    "problem_status": {"enum": ["open", "solved", "catalog_only", "unknown"]},
    "layer": {"const": "cultural_research_first"},
    "official_statement_ref": {"type": "string", "minLength": 1},
    "official_statement_hash": {"type": "string"},
    "formal_target_ref": {"type": "string"},
    "formal_target_hash": {"type": "string"},
    "semantic_fidelity_status": {"enum": ["UNTRUSTED", "PARTIAL", "VERIFIED", "FAILED"]},
    "semantic_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "quantifiers", "asymptotic_model", "computational_model", "assumptions", "conclusion"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "quantifiers": {"type": "string", "minLength": 1},
        "asymptotic_model": {"type": "string", "minLength": 1},
        "computational_model": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "conclusion": {"type": "string", "minLength": 1}
      }
    },
    "conceptual_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "statement", "epistemic_status", "theorem_claim_excluded"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["candidate", "operational", "audited", "unknown"]},
        "theorem_claim_excluded": {"type": "boolean"}
      }
    },
    "known_barriers": {"type": "array", "items": {"type": "string"}},
    "dead_routes": {"type": "array", "items": {"type": "string"}},
    "search_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "description", "budget_class"],
        "properties": {
          "policy_id": {"enum": ["SIMPLE", "GRAVEYARD", "ALIEN", "CURATOR"]},
          "description": {"type": "string", "minLength": 1},
          "budget_class": {"enum": ["small", "bounded", "review"]}
        }
      }
    },
    "cross_domain_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "relation", "meaning"],
        "properties": {
          "domain": {"enum": ["cultura", "curatoria", "portfolio", "research", "mathematics"]},
          "relation": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "producer", "status"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "producer": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "audited", "curator_required"]}
      }
    }
  }
}
