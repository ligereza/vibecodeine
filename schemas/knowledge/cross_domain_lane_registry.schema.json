{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mak.local/schemas/knowledge/cross_domain_lane_registry.schema.json",
  "title": "MAK cross-domain cultural research lane registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "title", "layer", "policy", "lanes", "provenance"],
  "properties": {
    "schema": {"const": "mak-cross-domain-lane-registry-v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "layer": {"const": "cultural_research_first"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared_infrastructure", "semantic_transfer_rule", "promotion_rule"],
      "properties": {
        "shared_infrastructure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "semantic_transfer_rule": {"type": "string", "minLength": 1},
        "promotion_rule": {"type": "string", "minLength": 1}
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id", "title", "priority", "dialects", "epistemic_status",
          "source_status", "current_state", "evidence_refs", "next_gate", "guardrails"
        ],
        "properties": {
          "lane_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 0, "maximum": 3},
          "dialects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "epistemic_status": {"enum": ["observed", "candidate", "derived", "predicted", "counterfactual", "unknown"]},
          "source_status": {"enum": ["verified", "provided_bundle", "partial", "proposal", "unavailable"]},
          "current_state": {"enum": ["implemented", "partial", "proposal", "catalog_only", "blocked"]},
          "consumer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_id", "path", "mode"],
            "properties": {
              "tool_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "mode": {"enum": ["read_only", "plan_only", "metadata_only"]}
            }
          },
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "implementation": {"type": "array", "items": {"type": "string"}},
          "next_gate": {"type": "string", "minLength": 1},
          "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "producer", "status"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "producer": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "audited", "operational"]}
      }
    }
  }
}
