{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mak.local/schemas/knowledge/math_result_card.schema.json",
  "title": "MAK mathematical result card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "card_id",
    "target_id",
    "candidate_id",
    "status",
    "validator",
    "candidate_hash",
    "target_hash",
    "semantic_fidelity",
    "failure_class",
    "next_actions",
    "artifact_refs"
  ],
  "properties": {
    "schema": {"const": "mak-math-result-card-v1"},
    "card_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "UNKNOWN",
        "GENERATED",
        "LEGAL",
        "ILLEGAL",
        "KILLED",
        "SURVIVED",
        "COUNTEREXAMPLE_VERIFIED",
        "LEMMA_VERIFIED",
        "PROOF_VERIFIED",
        "FORMAL_TARGET_UNTRUSTED",
        "NEEDS_MATH_CURATOR"
      ]
    },
    "validator": {"type": "string", "minLength": 1},
    "validator_version": {"type": "string"},
    "candidate_hash": {"type": "string", "minLength": 1},
    "target_hash": {"type": "string", "minLength": 1},
    "semantic_fidelity": {"enum": ["UNTRUSTED", "PARTIAL", "VERIFIED", "FAILED"]},
    "failure_class": {"type": "string", "minLength": 1},
    "kill_radius": {"type": "number", "minimum": 0, "maximum": 1},
    "representation_gain": {"type": "number"},
    "verification_cost": {"type": "number", "minimum": 0},
    "novelty": {"type": "number", "minimum": 0, "maximum": 1},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sealed_payload_ref": {"type": "string"},
    "certificate_ref": {"type": "string"},
    "axiom_report": {"enum": ["CLEAN", "EXPECTED_AXIOMS", "UNEXPECTED_AXIOMS", "TARGET_ASSUMED", "UNKNOWN"]},
    "dependency_lock_hash": {"type": "string"},
    "scope": {"type": "string"}
  }
}
