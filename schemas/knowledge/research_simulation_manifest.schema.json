{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mak.local/schemas/knowledge/research_simulation_manifest.schema.json",
  "title": "MAK bounded research simulation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "simulation_id", "project_id", "domain", "axiom", "rules", "iterations", "claim_scope", "provenance"],
  "properties": {
    "schema": {"const": "mak-research-simulation-manifest-v1"},
    "simulation_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "axiom": {"type": "string", "minLength": 1},
    "rules": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 0}},
    "iterations": {"type": "integer", "minimum": 0, "maximum": 12},
    "max_symbols": {"type": "integer", "minimum": 1, "maximum": 100000},
    "claim_scope": {"enum": ["visual_grammar", "symbolic_projection"]},
    "environment": {"type": "object"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_refs"],
      "properties": {"evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    }
  }
}
