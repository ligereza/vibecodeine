{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operational zone overlay for XIO / FOH / VJ",
  "description": "Declarative physical and logical layer for plano-rider. It documents topology only; it never activates transports.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "schema_version": { "type": "string", "default": "0.1" },
    "zones": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["zone_id"],
        "properties": {
          "zone_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "kind": { "type": "string" },
          "plane": { "enum": ["physical", "logical"] },
          "purpose": { "type": "string" },
          "x_m": { "type": "number" },
          "y_m": { "type": "number" },
          "w_m": { "type": "number", "exclusiveMinimum": 0 },
          "h_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["node_id"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "zone_id": { "type": "string" },
          "role": { "type": "string" },
          "mode": { "type": "string" },
          "active_writer": { "type": "boolean" },
          "writer_groups": { "type": "array", "items": { "type": "string" } },
          "x_m": { "type": "number" },
          "y_m": { "type": "number" },
          "w_m": { "type": "number", "exclusiveMinimum": 0 },
          "h_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "channel": { "type": "string" },
          "transport": { "type": "string" },
          "direction": { "type": "string" }
        }
      }
    }
  }
}
